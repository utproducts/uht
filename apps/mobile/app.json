{
  "expo": {
    "name": "UHT",
    "slug": "uht",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b26f3538-a6ef-485a-b9e1-b2fff20ac9b0"
    },
    "splash": {
      "backgroundColor": "#003e79"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ultimatetournaments.uht",
      "appleTeamId": "4AT4Z2ABQP",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to quickly sign in to your UHT account",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ultimatetournaments.uht",
      "adaptiveIcon": {
        "backgroundColor": "#003e79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to sign in to UHT"
        }
      ],
      "expo-notifications",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "b26f3538-a6ef-485a-b9e1-b2fff20ac9b0"
      }
    },
    "owner": "utp1"
  }
}
